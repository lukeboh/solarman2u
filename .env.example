# Copie para .env (nunca commitar o .env real) e preencha os valores.

# --- Credenciais Solarman (home.solarmanpv.com) ---
SOLARMAN_USERNAME=
SOLARMAN_PASSWORD=
# Host do portal (troque se sua conta usa um subdomínio regional diferente)
SOLARMAN_BASE_URL=https://home.solarmanpv.com

# IDs das usinas a monitorar, separados por vírgula.
# Deixe em branco para monitorar todas as usinas visíveis na conta.
SOLARMAN_STATION_IDS=

# --- Limiares de detecção de início/fim de geração ---
# Potência (W) acima da qual consideramos que a usina "começou a produzir"
PRODUCTION_START_THRESHOLD_W=20
# Potência (W) abaixo da qual consideramos que a usina "parou de produzir"
PRODUCTION_END_THRESHOLD_W=5
# Nº de leituras consecutivas abaixo do limiar para confirmar o fim (evita
# falso alarme por nuvem passageira)
PRODUCTION_END_CONFIRMATIONS=3
# Não considera "fim de produção" antes deste horário local (HH:MM)
PRODUCTION_END_NOT_BEFORE=10:00

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
# destinatários separados por vírgula
ALERT_EMAIL_TO=

# --- Fuso horário local (para janelas de horário e reset diário) ---
LOCAL_TIMEZONE=America/Sao_Paulo
